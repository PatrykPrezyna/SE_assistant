# Copy to .env and fill in. .env is gitignored. Do not commit the key.
#
# Cloud subscription (OpenAI-compatible chat completions).
# Parley at MIT:
#   ASSISTANT_BASE_URL=https://parley.api.mit.edu/v1
#   ASSISTANT_API_KEY=
#   ASSISTANT_MODEL=claude-haiku-4-5
# OpenAI:
#   ASSISTANT_BASE_URL=https://api.openai.com/v1
#   ASSISTANT_API_KEY=
#   ASSISTANT_MODEL=
#
# Azure-style key header instead of Authorization: Bearer
#   ASSISTANT_AUTH=api-key
#   ASSISTANT_CHAT_PATH=/openai/deployments/your-deployment/chat/completions?api-version=2024-06-01
#
# Local model later (Ollama), same client:
#   ASSISTANT_BASE_URL=http://127.0.0.1:11434/v1
#   ASSISTANT_API_KEY=
#   ASSISTANT_MODEL=llama3.1

ASSISTANT_BASE_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
MODEL_FOLDER=
EXPLORER_URL=http://127.0.0.1:8199/
ASSISTANT_PORT=8201
